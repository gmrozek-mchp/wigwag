{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "IDLE",
              "SessionStart"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "UserPromptSubmit"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "PreToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "PostToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "PermissionRequest"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Elicitation"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "ElicitationResult"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Notification/permission_prompt"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Notification/idle_prompt"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Notification/agent_needs_input"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "IDLE",
              "Stop"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "ERROR",
              "StopFailure"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/skills/journal/journal-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "DROP"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
