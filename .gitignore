# --- secrets: never commit ---
firmware/credentials.conf
host/.env
*.pem
*.key

# --- west workspace (topdir is the repo root; pinned by firmware/west.yml) ---
/.west/
/zephyr/
/modules/
/bootloader/
/tools/

# --- build output ---
build/
twister-out*/
enclosure/stl/
__pycache__/
*.pyc
.venv/
.pytest_cache/

# --- KiCad ---
# The .kicad_sch / .kicad_sym / sym-lib-table / .kicad_pro are sources, and the schematic is
# generated by hardware/gen_schematic.py. Everything below is derived — regenerate with:
#   python3 hardware/gen_schematic.py
#   kicad-cli sch erc --output erc.rpt hardware/kicad/wigwag.kicad_sch
#   kicad-cli sch export pdf --output hardware/kicad/wigwag.pdf hardware/kicad/wigwag.kicad_sch
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache
~*.*
*.net
*.rpt
hardware/kicad/*.pdf

# --- mosquitto persistence, if a broker is run from inside the repo ---
mosquitto.db

# --- session transcript archive (SpecStory extension) ---
.specstory/

# --- macOS ---
.DS_Store
