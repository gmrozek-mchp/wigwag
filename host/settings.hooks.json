{
  "//": "wigwag hook wiring. Merge the entries below into your .claude/settings.json 'hooks' object. Exec form throughout so ${CLAUDE_PROJECT_DIR} needs no quoting and works on every platform. On Windows without Git Bash, swap the command for: powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify.ps1. TWO THINGS LEARNED THE HARD WAY (D123, journal 2026-08-15). (1) One matcher per Notification type: a combined 'permission_prompt|idle_prompt|agent_needs_input' matcher never fires, because matchers filter on the notification type and no type contains a pipe -- which made WAIT unreachable from Phase 1 until it was caught by driving a real session. (2) There is NO event for a user rejecting or interrupting a tool call, and PermissionDenied is not it -- that fires only when auto mode denies a call. So a WAIT entered by PermissionRequest has no exit edge and clears only when the user next types (UserPromptSubmit) or the daemon's session TTL expires. Elicitation is the MCP equivalent and does have an exit edge (ElicitationResult).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "IDLE",
              "SessionStart"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "UserPromptSubmit"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "PreToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "PostToolUse"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "PermissionRequest"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Elicitation"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "BUSY",
              "ElicitationResult"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Notification/permission_prompt"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Notification/idle_prompt"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "WAIT",
              "Notification/agent_needs_input"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "IDLE",
              "Stop"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "SET",
              "ERROR",
              "StopFailure"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": [
              "DROP"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
