{
  "//": "wigwag hook wiring. Merge the SessionStart/UserPromptSubmit/... entries below into your .claude/settings.json 'hooks' object. Exec form is used throughout so ${CLAUDE_PROJECT_DIR} needs no quoting and works on every platform. On Windows without Git Bash, swap the command for: powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify.ps1",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["SET", "IDLE", "SessionStart"],
            "timeout": 5
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["SET", "BUSY", "UserPromptSubmit"],
            "timeout": 5
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["SET", "BUSY", "PreToolUse"],
            "timeout": 5
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["SET", "BUSY", "PostToolUse"],
            "timeout": 5
          }
        ]
      }
    ],

    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["SET", "WAIT", "Notification"],
            "timeout": 5
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["SET", "IDLE", "Stop"],
            "timeout": 5
          }
        ]
      }
    ],

    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["SET", "ERROR", "StopFailure"],
            "timeout": 5
          }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/host/hooks/wg-notify",
            "args": ["DROP"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
