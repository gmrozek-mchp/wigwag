/*
 * D49 — TCC0 PWM enablement for PIC32CM PL10.
 *
 * Mainline Zephyr has the driver (drivers/pwm/pwm_mchp_tcc_g1.c) and the binding
 * (dts/bindings/pwm/microchip,tcc-g1-pwm.yaml), and hal_microchip has the pinmux macros and
 * both clock IDs — but the PL10 devicetree defines no TC or TCC node at all, so nothing binds.
 * Everything below is the missing board/SoC layer, in the shape mainline already uses for the
 * sibling JH01 family (dts/arm/microchip/pic32c/pic32cm_jh/common/pic32cm_5164_jh.dtsi).
 *
 * Values verified rather than copied — the JH01 numbers are wrong for this part:
 *   reg           0x42001800   TCC0_BASE_ADDRESS, hal_microchip pic32cm6408pl10048.h
 *   interrupts    12           TCC0_IRQn, same header; datasheet Table 4-3
 *   channels      4            TCC_CC[4] / TCC_CCBUF[4], component/tcc.h
 *   max-bit-width 16           TCC_COUNT_Msk == 0x0000FFFF — the JH01's TCC is 24-bit, this
 *                              one is not, and claiming 24 would silently accept periods the
 *                              counter cannot represent
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	soc {
		tcc0: tcc@42001800 {
			compatible = "microchip,tcc-g1-pwm";
			reg = <0x42001800 0x80>;
			interrupts = <12 0>;
			clocks = <&mclkperiph CLOCK_MCHP_MCLKPERIPH_ID_APBC_TCC0>,
				 <&gclkperiph CLOCK_MCHP_GCLKPERIPH_ID_TCC0>;
			clock-names = "mclk", "gclk";
			channels = <4>;
			max-bit-width = <16>;
			/*
			 * GCLK0 is 24 MHz (board dts). At DIV1 a 16-bit counter reaches down to
			 * 24e6/65536 = 366 Hz, so the 500 Hz lamp carrier below fits with 48000
			 * counts of dimming resolution and no prescaler.
			 */
			prescaler = <1>;
			#pwm-cells = <3>;
			pinctrl-0 = <&tcc0_pwm_default>;
			pinctrl-names = "default";
			status = "okay";
		};
	};

	/*
	 * The three lamps (D46: TCC0 WO0/WO1/WO2). On the Curiosity Nano:
	 *
	 *   green   WO0   PA24   external LED + 470R-1k to GND      active high
	 *   red     WO1   PA25   external LED + 470R-1k to GND      active high
	 *   yellow  WO2   PB02   the board's own yellow LED         active LOW
	 *
	 * **The polarity cells do nothing without firmware/patches/0001-*.patch applied.**
	 * Mainline's microchip,tcc-g1-pwm.yaml names its third pwm-cell "polarity", while Zephyr
	 * resolves flags via DT_PHA_BY_IDX_OR(..., flags, 0) — so an unpatched tree silently
	 * discards them. main.c prints the resolved flags at boot for exactly that reason (D74).
	 *
	 * PB02's active-low wiring is the board's, not the product's: its user guide §4.1 says
	 * "driving the connected I/O line to GND will activate the LED" while mainline's board
	 * devicetree claims GPIO_ACTIVE_HIGH, which is a second upstream bug (D72).
	 */
	pwmleds {
		compatible = "pwm-leds";

		/*
		 * Polarity is per lamp, and on this board it genuinely differs: the on-board yellow
		 * LED is wired active low (D72), while externally wired lamps go pin -> resistor ->
		 * LED -> GND and are active high. The PCB will be uniformly active high through
		 * low-side FETs (D26), so nothing may assume a single polarity.
		 */
		lamp_green: lamp_green {
			pwms = <&tcc0 0 PWM_USEC(2000) PWM_POLARITY_NORMAL>;
		};

		lamp_red: lamp_red {
			pwms = <&tcc0 1 PWM_USEC(2000) PWM_POLARITY_NORMAL>;
		};

		lamp_yellow: lamp_yellow {
			pwms = <&tcc0 2 PWM_USEC(2000) PWM_POLARITY_INVERTED>;
		};
	};

	/*
	 * SW0, the board's user switch. Active low — pressing it connects the pin to GND — and there
	 * is no external pull-up, so the internal one is required (user guide §4.2).
	 *
	 * Described with gpio-keys for the standard shape, but read by polling rather than through
	 * the input subsystem: PL10's devicetree has no EIC node, so a pin interrupt would mean
	 * enabling an interrupt controller to save nothing on a button (D86). GPIO_ACTIVE_LOW means
	 * gpio_pin_get_dt() returns 1 when pressed, so no inversion in the code.
	 *
	 * PB03 is shared with the on-board debugger (DBG2), which tri-states it when inactive.
	 */
	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&portb 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		sw0 = &button0;
		lamp-green = &lamp_green;
		lamp-yellow = &lamp_yellow;
		lamp-red = &lamp_red;
	};

	/*
	 * Which UART the RNWF02 lives on. A chosen node rather than an alias because it names a
	 * role in the system, and keeps the AT client free of board-specific labels.
	 */
	chosen {
		wigwag,module-uart = &sercom0;
	};
};

&pinctrl {
	tcc0_pwm_default: tcc0_pwm_default {
		group1 {
			/*
			 * Three lamps on one TCC: WO0 = PA24, WO1 = PA25, WO2 = PB02, all
			 * peripheral function F. PA24/PA25 are the 32.768 kHz crystal's I/O lines,
			 * which the board routes to the edge connector by default (cut straps J107
			 * and J108 intact), so they are free without rework.
			 */
			pinmux = <PA24F_TCC0_WO0>, <PA25F_TCC0_WO1>, <PB2F_TCC0_WO2>;
		};
	};

	/*
	 * The module UART. SERCOM0 on the PCB too (D46), so the dev board exercises the same
	 * peripheral the product uses.
	 *
	 * PA04/PA05 chosen by elimination on this board: the debugger holds PB00/PB01 (the CDC
	 * console), PA20 (SWDIO), PA31 (SWCLK), PB03 (SW0) and PA30 (RESET); PA24/PA25 are the
	 * 32.768 kHz crystal footprint; PB08/PB09 are the touch button; and PA08-PA15 sit in the
	 * MVIO domain powered from VDDIO2, which is a needless dependency for a UART.
	 *
	 * Note porta is left status = "disabled". The pinctrl driver builds its port address table
	 * with DT_NODE_EXISTS rather than a status check, so muxing works without instantiating a
	 * GPIO device we never use.
	 */
	sercom0_uart_default: sercom0_uart_default {
		group1 {
			pinmux = <PA4C_SERCOM0_PAD0>, <PA5C_SERCOM0_PAD1>;
		};
	};
};

/*
 * SERCOM0 as the module UART: PAD0 transmits, PAD1 receives, matching the board's own sercom1
 * console wiring (txpo = 0, rxpo = 1).
 */
&sercom0 {
	compatible = "microchip,sercom-g1-uart";
	#address-cells = <1>;
	#size-cells = <0>;
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	stop-bits = "1";
	rxpo = <1>;
	txpo = <0>;
	pinctrl-0 = <&sercom0_uart_default>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * The generic clock channel is set up from devicetree children at init —
 * DT_FOREACH_CHILD(DT_NODELABEL(gclkperiph), ...) in
 * drivers/clock_control/clock_control_mchp_pic32cm_pl.c — so without this entry the TCC has a
 * bus clock, binds cleanly, and produces nothing.
 */
&gclkperiph {
	tcc0_gclk {
		subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_TCC0>;
		gclkperiph-src = "gclk0";
		gclkperiph-en = <1>;
	};

	/* Same requirement for SERCOM0: no channel here means a UART that never clocks. */
	sercom0_gclk {
		subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM0_CORE>;
		gclkperiph-src = "gclk0";
		gclkperiph-en = <1>;
	};
};

/*
 * PB02 carries both the Curiosity Nano's LED0 and TCC0/WO2 (datasheet §2.3), which is what
 * makes this spike need no external wiring. Hand the pin to TCC0 and say so in the
 * devicetree, rather than leaving two drivers able to claim it.
 */
&led0 {
	status = "disabled";
};

/*
 * Disable the 32.768 kHz crystal oscillator — **this is what makes PA24 and PA25 usable at all.**
 *
 * They are XTAL32K1 and XTAL32K2, and datasheet §13.5.1 is unconditional: "the XTAL32K1 and XTAL32K2
 * pins are automatically configured when the XOSC32K oscillator is enabled". The board devicetree
 * enables it (`xosc32k-en = <1>`), so TCC0's pinmux on both pins was accepted and then silently
 * ignored — no error anywhere, because the override happens in the oscillator rather than in PORT.
 *
 * Verified by a controlled A/B on hardware rather than by reading: identical firmware and wiring,
 * only this property changed, lamps driven to full by the power-on test. Both pins dead with the
 * oscillator enabled, both working with it disabled.
 *
 * Worth knowing that §13.4.2.2 claims the override is mode-dependent — that in External Clock mode
 * only XTAL32K1 is taken and XTAL32K2 "may be used as a GPIO pin". This board *is* in that mode
 * (`xosc32k-xtal-en` defaults to 0, confirmed in devicetree_generated.h), and PA25 is taken anyway.
 * Do not trust that sentence on this part.
 *
 * The board's crystal is also not connected by default — its user guide routes these I/O lines to the
 * edge connector, and attaching the crystal means cutting straps J107/J108 — so the oscillator is
 * enabled, unusable and unused (`gclkgen0` is sourced from OSCHF).
 *
 * Measured, so as not to overstate the cost: enabling it adds **no** boot time here. Reset to first
 * console byte was 1624 ms enabled against 1621 ms disabled. The driver's WAIT_FOR on XOSC32KRDY uses
 * a 1000000 us timeout that looks like a one-second stall; it is not.
 *
 * Nothing here needs it. Re-enable only alongside moving the green and red lamps off PA24/PA25.
 */
&xosc32k {
	xosc32k-en = <0>;
	xosc32k-cfd-en = <0>;
};
