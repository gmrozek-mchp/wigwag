/*
 * D49 — TCC0 PWM enablement for PIC32CM PL10.
 *
 * Mainline Zephyr has the driver (drivers/pwm/pwm_mchp_tcc_g1.c) and the binding
 * (dts/bindings/pwm/microchip,tcc-g1-pwm.yaml), and hal_microchip has the pinmux macros and
 * both clock IDs — but the PL10 devicetree defines no TC or TCC node at all, so nothing binds.
 * Everything below is the missing board/SoC layer, in the shape mainline already uses for the
 * sibling JH01 family (dts/arm/microchip/pic32c/pic32cm_jh/common/pic32cm_5164_jh.dtsi).
 *
 * Values verified rather than copied — the JH01 numbers are wrong for this part:
 *   reg           0x42001800   TCC0_BASE_ADDRESS, hal_microchip pic32cm6408pl10048.h
 *   interrupts    12           TCC0_IRQn, same header; datasheet Table 4-3
 *   channels      4            TCC_CC[4] / TCC_CCBUF[4], component/tcc.h
 *   max-bit-width 16           TCC_COUNT_Msk == 0x0000FFFF — the JH01's TCC is 24-bit, this
 *                              one is not, and claiming 24 would silently accept periods the
 *                              counter cannot represent
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	soc {
		tcc0: tcc@42001800 {
			compatible = "microchip,tcc-g1-pwm";
			reg = <0x42001800 0x80>;
			interrupts = <12 0>;
			clocks = <&mclkperiph CLOCK_MCHP_MCLKPERIPH_ID_APBC_TCC0>,
				 <&gclkperiph CLOCK_MCHP_GCLKPERIPH_ID_TCC0>;
			clock-names = "mclk", "gclk";
			channels = <4>;
			max-bit-width = <16>;
			/*
			 * GCLK0 is 24 MHz (board dts). At DIV1 a 16-bit counter reaches down to
			 * 24e6/65536 = 366 Hz, so the 500 Hz lamp carrier below fits with 48000
			 * counts of dimming resolution and no prescaler.
			 */
			prescaler = <1>;
			#pwm-cells = <3>;
			pinctrl-0 = <&tcc0_pwm_default>;
			pinctrl-names = "default";
			status = "okay";
		};
	};

	/*
	 * One lamp channel for the spike. On the PCB this becomes three (D46: WO0/WO1/WO2).
	 *
	 * PWM_POLARITY_INVERTED, because **the Curiosity Nano's LED0 is active low** — its user
	 * guide §4.1 says "driving the connected I/O line to GND will activate the LED", and
	 * Table 4-1 lists it as "active low". Without the inversion, duty means darkness and the
	 * lamp reads backwards.
	 *
	 * Note that mainline's board devicetree disagrees: pic32cm_pl10_cnano.dts declares
	 * led0 as GPIO_ACTIVE_HIGH. That is an upstream bug — blinky and a symmetric fade both
	 * look identical either way, which is presumably how it survived. Confirmed on hardware by
	 * the asymmetry of the cubic gamma ramp: with NORMAL polarity the lamp sat lit with a brief
	 * dark dip, the exact inverse of the intended breath.
	 *
	 * **This cell does nothing without firmware/patches/0001-*.patch applied.** Mainline's
	 * microchip,tcc-g1-pwm.yaml names its third pwm-cell "polarity", while Zephyr resolves
	 * flags via DT_PHA_BY_IDX_OR(..., flags, 0) — so an unpatched tree silently discards this
	 * value. main.c prints the resolved flags at boot for exactly that reason.
	 *
	 * **This inversion is specific to the dev board.** The PCB drives its lamps through
	 * low-side N-FETs (D26, ADR-0009), where a high gate turns the lamp on — so the product is
	 * active high and lamp.c must take polarity from devicetree rather than inherit this.
	 */
	pwmleds {
		compatible = "pwm-leds";

		lamp_yellow: lamp_yellow {
			pwms = <&tcc0 2 PWM_USEC(2000) PWM_POLARITY_INVERTED>;
		};
	};

	aliases {
		lamp-yellow = &lamp_yellow;
	};

	/*
	 * Which UART the RNWF02 lives on. A chosen node rather than an alias because it names a
	 * role in the system, and keeps the AT client free of board-specific labels.
	 */
	chosen {
		wigwag,module-uart = &sercom0;
	};
};

&pinctrl {
	tcc0_pwm_default: tcc0_pwm_default {
		group1 {
			/* PB02, peripheral function F. */
			pinmux = <PB2F_TCC0_WO2>;
		};
	};

	/*
	 * The module UART. SERCOM0 on the PCB too (D46), so the dev board exercises the same
	 * peripheral the product uses.
	 *
	 * PA04/PA05 chosen by elimination on this board: the debugger holds PB00/PB01 (the CDC
	 * console), PA20 (SWDIO), PA31 (SWCLK), PB03 (SW0) and PA30 (RESET); PA24/PA25 are the
	 * 32.768 kHz crystal footprint; PB08/PB09 are the touch button; and PA08-PA15 sit in the
	 * MVIO domain powered from VDDIO2, which is a needless dependency for a UART.
	 *
	 * Note porta is left status = "disabled". The pinctrl driver builds its port address table
	 * with DT_NODE_EXISTS rather than a status check, so muxing works without instantiating a
	 * GPIO device we never use.
	 */
	sercom0_uart_default: sercom0_uart_default {
		group1 {
			pinmux = <PA4C_SERCOM0_PAD0>, <PA5C_SERCOM0_PAD1>;
		};
	};
};

/*
 * SERCOM0 as the module UART: PAD0 transmits, PAD1 receives, matching the board's own sercom1
 * console wiring (txpo = 0, rxpo = 1).
 */
&sercom0 {
	compatible = "microchip,sercom-g1-uart";
	#address-cells = <1>;
	#size-cells = <0>;
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	stop-bits = "1";
	rxpo = <1>;
	txpo = <0>;
	pinctrl-0 = <&sercom0_uart_default>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * The generic clock channel is set up from devicetree children at init —
 * DT_FOREACH_CHILD(DT_NODELABEL(gclkperiph), ...) in
 * drivers/clock_control/clock_control_mchp_pic32cm_pl.c — so without this entry the TCC has a
 * bus clock, binds cleanly, and produces nothing.
 */
&gclkperiph {
	tcc0_gclk {
		subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_TCC0>;
		gclkperiph-src = "gclk0";
		gclkperiph-en = <1>;
	};

	/* Same requirement for SERCOM0: no channel here means a UART that never clocks. */
	sercom0_gclk {
		subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM0_CORE>;
		gclkperiph-src = "gclk0";
		gclkperiph-en = <1>;
	};
};

/*
 * PB02 carries both the Curiosity Nano's LED0 and TCC0/WO2 (datasheet §2.3), which is what
 * makes this spike need no external wiring. Hand the pin to TCC0 and say so in the
 * devicetree, rather than leaving two drivers able to claim it.
 */
&led0 {
	status = "disabled";
};
