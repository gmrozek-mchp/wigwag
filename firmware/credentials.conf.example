# Copy to `firmware/credentials.conf` (gitignored) and edit.
#
# CMakeLists.txt merges that file automatically when it exists, so `west build` picks it up with no
# extra arguments. Everything here is a *default*: once a unit has been configured over the console
# its stored settings win, so these values matter mainly for a fresh device or a bench build.
#
# These end up as plaintext strings in the firmware image. Do not commit the real file, and do not
# paste its contents into the journal or a bug report.

CONFIG_WIGWAG_SSID="my-network"
CONFIG_WIGWAG_PASS="my-passphrase"

# enum rnwf_sec_type from firmware/src/rnwf_at_cmds.h: 0 = open, 3 = WPA2 mixed personal.
CONFIG_WIGWAG_SEC=3

CONFIG_WIGWAG_BROKER="mqtt.example.lan"
CONFIG_WIGWAG_PORT=1883
CONFIG_WIGWAG_CLIENT="wigwag-desk"

# Only if your broker requires authentication (ADR-0011).
CONFIG_WIGWAG_USER=""
CONFIG_WIGWAG_MQTTPASS=""
